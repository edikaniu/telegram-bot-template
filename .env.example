# ========================================
# Telegram Bot Template - Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# -----------------------
# REQUIRED CONFIGURATION
# -----------------------

# Telegram Bot Token (REQUIRED)
# Get your bot token from BotFather: https://t.me/botfather
# 1. Open chat with @BotFather in Telegram
# 2. Send /newbot command
# 3. Follow prompts to create your bot
# 4. Copy the token provided
# Example format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin User IDs (REQUIRED)
# Telegram user ID(s) with admin access to the bot
# Get your user ID: https://t.me/userinfobot
# Format: Comma-separated numbers (no spaces)
# Example: 123456789,987654321
BOT_ADMIN_IDS=your_user_id_here

# -----------------------
# AI INTEGRATION (OPTIONAL)
# -----------------------

# Anthropic Claude API Key (Optional - enables AI conversational responses)
# Get from: https://console.anthropic.com/
# If not provided, bot will use fallback responses
# Example: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=

# OpenAI API Key (Optional - not currently implemented)
# Future support for GPT models
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------
# BOT BEHAVIOR SETTINGS
# -----------------------

# Environment Mode (Optional - default: production)
# Values: development, production, test
NODE_ENV=production

# Allowed Group IDs (Optional)
# Comma-separated group chat IDs where bot sends automated broadcasts
# Get group ID: Add @RawDataBot to your group, copy the chat.id value
# Note: Group IDs are negative numbers
# Example: -1001234567890,-1009876543210
ALLOWED_GROUP_IDS=

# -----------------------
# SCHEDULING & INTERVALS
# -----------------------

# Market Data Update Interval (Optional - default: 30 minutes)
# How often to refresh market/fund data from data sources
# Value in minutes
MARKET_UPDATE_INTERVAL=30

# News Check Interval (Optional - default: 15 minutes)
# How often to check for new news articles
# Value in minutes
NEWS_CHECK_INTERVAL=15

# -----------------------
# DEPLOYMENT CONFIGURATION
# -----------------------

# Port (Optional - only for webhook mode)
# This template uses long polling by default (no port needed)
# If you switch to webhooks, Railway/Heroku will set this automatically
# PORT=3000

# Database URL (Optional - not used by default)
# If you implement database persistence instead of JSON files
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# -----------------------
# CUSTOM INTEGRATIONS
# -----------------------

# Add your custom API keys and configuration here
# Examples:
# WEATHER_API_KEY=
# PAYMENT_PROVIDER_KEY=
# CUSTOM_SERVICE_URL=

# -----------------------
# SECURITY NOTES
# -----------------------
# 1. NEVER share your .env file or commit it to Git
# 2. Use strong, unique API keys
# 3. Rotate keys if compromised
# 4. Limit admin access to trusted users only
# 5. For production: Use environment variables from your hosting platform
#    (Railway Dashboard, Heroku Config Vars, etc.)
